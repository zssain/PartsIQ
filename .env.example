# PartsIQ environment template. Copy to .env and replace placeholders locally.
# NO REAL SECRET BELONGS IN THIS FILE OR IN GIT. Values here are placeholders only.
# Authoritative variable list: spec/environment.json. Validator: tools/verify_env.py.
# Use URL-safe characters (letters, digits, '-', '_') in passwords embedded in URLs.

# =============================================================================
# Core (all services)
# =============================================================================
APP_ENV=local                      # local | test | production — never production in tests
LOG_LEVEL=INFO

# =============================================================================
# Supabase (Auth, Postgres, private Storage) — separate dev/prod projects
# =============================================================================
SUPABASE_URL=                      # operator input: project URL
SUPABASE_JWT_ISSUER=               # gateway: exact token issuer
SUPABASE_JWKS_URL=                 # gateway: trusted fixed JWKS URL
SUPABASE_STORAGE_KEY=              # worker ONLY: private object signing/cleanup; NOT database REST

# Web (browser-exposed; publishable values only, never secrets)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=          # HTTPS gateway origin

# =============================================================================
# Database (restricted per-service login roles; DDL is migration-only)
# =============================================================================
DATABASE_URL=                      # operator secret: each service gets a separate restricted login
MIGRATION_DATABASE_URL=            # migration only: DDL credential (prompts 02/03)
DATABASE_POOL_MAX=4
PRODUCTION_PROJECT_REF=            # tests/deploy denylist: refuse to run tests against this ref

# =============================================================================
# Internal service mesh (private network only; never exposed by Caddy)
# =============================================================================
INTERNAL_SERVICE_TOKEN=            # operator secret: 32-byte minimum shared internal token
SEARCH_URL=http://search:8000
ORCHESTRATOR_URL=http://orchestrator:8000
WORKER_URL=http://worker:8000
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=                   # gateway: exact Vercel origins (comma-separated)

# =============================================================================
# OpenAI (language + vision). Owner key, server-side only. No paid fallback.
# =============================================================================
OPENAI_API_KEY=                    # operator secret: never in the browser
OPENAI_MODEL_TEXT=gpt-4.1-mini-2025-04-14
OPENAI_MODEL_VISION=gpt-4.1-mini-2025-04-14

# AI credit allowance — DISABLED by default; enable only after credit preflight (ADR-015)
AI_ENABLED=false
AI_FREE_CREDIT_USD=0               # owner-confirmed dedicated allowance
AI_CREDIT_EXPIRES_AT=              # required UTC expiry when AI_ENABLED=true
AI_PAID_BUDGET_USD=0               # MUST stay 0 — no paid fallback is authorized
AI_DAILY_ALLOWANCE_USD=0
AI_SESSION_ALLOWANCE_USD=0
BUDGET_TIMEZONE=Asia/Kolkata

# =============================================================================
# Workflow / limits
# =============================================================================
WORKFLOW_MAX_STEPS=12
TOOL_MAX_CALLS=4
UPLOAD_MAX_BYTES=10485760          # 10 MiB
UPLOAD_MAX_PIXELS=24000000         # decode cap (decompression-bomb guard)
RATE_LIMIT_PER_MINUTE=20
DEMO_TTL_HOURS=24
STOCK_MAX_AGE_SECONDS=3600
NORMAL_REVIEW_HOURS=24             # non-contractual deadline
URGENT_REVIEW_HOURS=2             # non-contractual deadline

# =============================================================================
# Search embeddings (BGE-M3 loads ONLY inside the search service)
# =============================================================================
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181  # BAAI/bge-m3 pinned revision

# =============================================================================
# Telemetry (optional — system operates normally when unavailable)
# =============================================================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=               # operator secret: redacted traces only
LANGFUSE_BASE_URL=

# =============================================================================
# Deployment (operator input — never invent account IDs, domains or SHAs)
# =============================================================================
API_DOMAIN=
RELEASE_SHA=
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
AWS_ROLE_ARN=
EC2_INSTANCE_ID=

# =============================================================================
# Legacy local docker-compose.yml (preserved from the original backend).
# Needed only for the bundled local Compose stack; superseded by Supabase for
# the new architecture. Kept so `docker compose up` still works locally.
# =============================================================================
ENVIRONMENT=development
POSTGRES_DB=partsiq
POSTGRES_USER=partsiq
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password
GATEWAY_API_KEYS=replace-with-a-generated-key-of-at-least-32-characters
GATEWAY_RATE_LIMIT_PER_MINUTE=60
INSTALL_EMBEDDINGS=false
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# --- Workspace runtime (ADR 0002; docs/RUN_LIMITS.md) -------------------------------------
# Public recruiter demo (anonymous, disposable session sandboxes). false = invited accounts only.
DEMO_ENABLED=true
DEMO_MAX_WORKSPACES=400
# Legacy Supabase projects only (HS256). Server-side; leave empty when the project uses JWKS keys.
SUPABASE_JWT_SECRET=
# API ONLY (never NEXT_PUBLIC): Auth admin API for staff roles, invitations and the users screen.
SUPABASE_SERVICE_ROLE_KEY=
COLLABORATION_ENABLED=true
RUN_MAX_AGENT_TURNS=14
RUN_MAX_TOOL_CALLS=16
RUN_MAX_OUTPUT_TOKENS_PER_TURN=600
RUN_MAX_OUTPUT_TOKENS=6000
RUN_MAX_USD=0.05
RUN_MAX_WALL_SECONDS=180
RUN_MAX_RETRIES=1
RUN_MAX_CONCURRENT_PER_SCOPE=3
RUN_MAX_MESSAGE_BYTES=4096
RUN_MAX_INSTRUCTION_CHARS=500
FIXTURE_STEP_DELAY_MS=600
# tools/provision_accounts.py safety rails (never seed production).
PARTSIQ_PROVISION_TARGET=
PRODUCTION_SUPABASE_URL=
