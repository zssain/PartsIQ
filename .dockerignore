# Keep secrets and heavy local state out of every image build context.
.env
.env.*
!.env.example
**/*.pem
**/*.key
*.zip
.git
.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/node_modules
apps/web/.next
# The API image copies only apps/api/partsiq, spec/python-requirements.lock,
# tools/healthcheck.py and apps/web/public/brand (see apps/api/Dockerfile).
