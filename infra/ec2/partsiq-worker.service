# Background worker for the current EC2 host (systemd, same layout as the `partsiq` API unit).
# Install: sudo cp infra/ec2/partsiq-worker.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          && sudo systemctl enable --now partsiq-worker
# Needs: DATABASE_URL_WORKER (or DATABASE_URL_API), SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and
# REDIS_URL in the env file; Chromium installed once with
#   ~/.local/bin/uv run --all-packages playwright install --with-deps --only-shell chromium
[Unit]
Description=PartsIQ background worker (nameplate reading, PDF export)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/partsiq
EnvironmentFile=/home/ubuntu/partsiq/.env.runtime
ExecStart=/home/ubuntu/.local/bin/uv run --all-packages --frozen python -m partsiq.jobs.main
# SIGTERM drains: the current job finishes, no new job is claimed.
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
# One job at a time; a PDF render peaked at ~440 MB RSS (Python + Chromium). Keeps the API safe
# on a 2 GB t3.small.
MemoryMax=900M
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
